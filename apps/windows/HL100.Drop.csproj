<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>HL100Drop</AssemblyName>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/drop.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets/drop.ico" />
    <None Include="../../target/release/hl100_core.dll" Link="hl100_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../target/release/hl100_core.dll')" />
  </ItemGroup>
</Project>
