<Window x:Class="HL100.Drop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Icon="assets/drop.ico" Title="HL100 Drop" Width="1080" Height="760" MinWidth="800" MinHeight="560" AllowDrop="True" Drop="WindowDrop" Closing="WindowClosing">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Click="OpenSettings" Background="#262623" Foreground="{StaticResource Paper}" Content="НАСТРОЙКИ ↗"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="HL" FontSize="24" FontWeight="Bold"/><TextBlock Text="100" Foreground="{StaticResource Red}" FontSize="24" FontWeight="Bold"/><TextBlock Text="_ DROP" FontSize="24"/></StackPanel></DockPanel>
    <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" BorderBrush="{StaticResource Red}" BorderThickness="1" Padding="16" Margin="0,0,0,20"><DockPanel><Button DockPanel.Dock="Right" Content="ОБНОВИТЬСЯ ↗" Click="InstallUpdate"/><TextBlock x:Name="UpdateText" VerticalAlignment="Center"/></DockPanel></Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,24"><TextBlock Text="[ 01 / LOCAL CONNECTION ]" Foreground="{StaticResource Red}" FontSize="12"/><TextBlock Text="Hello, nearby_" FontSize="44" Margin="0,12,0,8"/><TextBlock x:Name="Identity" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Status" Text="Поиск устройств в локальной сети…" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="[ 02 / УСТРОЙСТВА ]" Margin="0,0,0,16"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="EmptyPeers" Text="Пока никого рядом.&#10;&#10;Открой HL100 Drop на другом устройстве&#10;в той же локальной сети." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/><StackPanel x:Name="PeerList"/><Border BorderBrush="#30302D" BorderThickness="1" Padding="16" Margin="0,12,0,0"><TextBlock Text="Перетащи файлы или папки&#10;на карточку получателя →" Foreground="{StaticResource Muted}"/></Border></StackPanel></ScrollViewer></Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="[ 03 / ПЕРЕДАЧИ ]" Margin="0,0,0,16"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="EmptyTransfers" Text="Твои передачи появятся здесь." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/><StackPanel x:Name="TransferList"/></StackPanel></ScrollViewer></Grid>
    </Grid>
    <Border Grid.Row="4" BorderBrush="#30302D" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,24,0,0"><DockPanel><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="DIRECT TRANSMISSION / LOCAL NETWORK" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel></Border>
  </Grid>
</Window>
