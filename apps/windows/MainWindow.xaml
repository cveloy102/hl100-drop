<Window x:Class="HL100.Drop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Icon="assets/drop.ico" Title="DROP" Width="1080" Height="800" MinWidth="800" MinHeight="600" WindowStyle="None" AllowDrop="True" Drop="WindowDrop" PreviewDragOver="WindowDragOver" PreviewDragLeave="WindowDragLeave" QueryContinueDrag="WindowQueryContinueDrag" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" BorderBrush="#30302D" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Background="#181817"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Click="MinimizeWindow" Background="Transparent" Foreground="{StaticResource Muted}" Padding="16,4"/><Button Content="□" Click="MaximizeWindow" Background="Transparent" Foreground="{StaticResource Muted}" Padding="16,4"/><Button Content="×" Click="CloseWindow" Background="Transparent" Foreground="{StaticResource Paper}" Padding="16,4"/></StackPanel><TextBlock Text="DROP / LOCAL NETWORK" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,0" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="1" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22"><Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="OpenSettings" Background="#262623" Foreground="{StaticResource Paper}" Content="НАСТРОЙКИ ↗" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><Viewbox Width="30" Height="30" Margin="0,0,12,0"><Path Data="M 13,0 L 2,15 L 11,15 L 8,28 L 23,10 L 14,10 L 17,0 Z" Fill="{StaticResource Red}"/></Viewbox><StackPanel><TextBlock Text="DROP" FontSize="36" FontWeight="Medium"/><TextBlock Text="HL100_" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel></DockPanel>
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" BorderBrush="{StaticResource Red}" BorderThickness="1" Padding="16" Margin="0,0,0,20"><DockPanel><Button DockPanel.Dock="Right" Content="ОБНОВИТЬСЯ ↗" Click="InstallUpdate"/><TextBlock x:Name="UpdateText" VerticalAlignment="Center"/></DockPanel></Border>
        <StackPanel x:Name="ConnectionHeader" Grid.Row="2" Margin="0,0,0,24"><TextBlock Text="[ 01 / LOCAL CONNECTION ]" Foreground="{StaticResource Red}" FontSize="12"/><TextBlock Text="Hello, nearby_" FontSize="38" Margin="0,12,0,8"/><TextBlock x:Name="Identity" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="Status" Text="Поиск устройств в локальной сети…" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
        <Grid x:Name="MainPage" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="[ 02 / УСТРОЙСТВА ]" Margin="0,0,0,16"/><ScrollViewer Style="{StaticResource DropScrollViewer}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0"><TextBlock x:Name="EmptyPeers" Text="Пока никого рядом.&#10;&#10;Открой DROP на другом устройстве&#10;в той же локальной сети." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/><StackPanel x:Name="PeerList"/><Border x:Name="DropHint" BorderBrush="#30302D" BorderThickness="1" Padding="16" Margin="0,12,0,0"><TextBlock x:Name="DropHintText" Text="Перетащи файлы или папки&#10;на карточку получателя →" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer></Grid>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="[ 03 / ПЕРЕДАЧИ ]" Margin="0,0,0,16"/><ScrollViewer Style="{StaticResource DropScrollViewer}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,12,0"><TextBlock x:Name="EmptyTransfers" Text="Твои передачи появятся здесь." Foreground="{StaticResource Muted}" Margin="0,8,0,20"/><StackPanel x:Name="TransferList"/></StackPanel></ScrollViewer></Grid>
        </Grid>
        <ScrollViewer Style="{StaticResource DropScrollViewer}" x:Name="SettingsPage" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsContent" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,16,0"/></ScrollViewer>
        <Border Grid.Row="4" BorderBrush="#30302D" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,24,0,0"><DockPanel><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="DIRECT TRANSMISSION / LOCAL NETWORK" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
